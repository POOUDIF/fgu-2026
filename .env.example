# Salin menjadi .env lalu isi. JANGAN commit .env.

# production | development | testing
CI_ENV=production

# URL dasar aplikasi, wajib diakhiri "/" (contoh: https://fgu.example.com/)
BASE_URL=http://localhost:8080/

# Database MySQL 8 / MariaDB 10.5+
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fgu_2026
DB_USER=fgu
DB_PASS=

# Wajib diisi string acak >= 32 karakter: php -r "echo bin2hex(random_bytes(32));"
ENCRYPTION_KEY=

# Aktifkan (true) bila aplikasi dilayani lewat HTTPS
COOKIE_SECURE=false

# 0=mati, 1=error, 2=debug, 3=info, 4=semua
LOG_THRESHOLD=1

# Lokasi berkas foto peserta (di luar webroot). Default: writable/uploads/participants
# UPLOAD_PATH=
