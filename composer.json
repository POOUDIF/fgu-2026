{
    "name": "fgu/fgu-2026",
    "description": "Festival Generasi Unggul 3.0 (Bekasi Barat, 2026) - CodeIgniter 3",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "ext-fileinfo": "*",
        "phpoffice/phpspreadsheet": "^2.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "application/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find application public tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
